# À AJOUTER au .env du VPS (créé par `npm run wallet`). Ne jamais le copier depuis ton Mac.

# Le proxy est public derrière Caddy : mot de passe admin obligatoire, clés de démo refusées
PROXY_PUBLIC=true
PROXY_PUBLIC_HOST=agentpay.pdf-libre.de

# Démo pour les jurys : tableau de bord consultable sans mot de passe
# (les exports, l'ancrage et l'administration restent protégés). Mettre false pour un vrai client.
DASHBOARD_PUBLIC_READ=true

# Serveur MCP en HTTP : accepter les requêtes arrivant par le nom de domaine public
MCP_ALLOWED_HOSTS=agentpay.pdf-libre.de

# Telegram : utiliser un AUTRE bot que sur ton Mac (un bot ne peut être lu que par un seul programme à la fois)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
