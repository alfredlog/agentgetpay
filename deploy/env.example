# À AJOUTER au .env du VPS (créé par `npm run wallet`). Ne jamais le copier depuis ton Mac.

# Le proxy est public derrière Caddy : mot de passe admin obligatoire, clés de démo refusées
PROXY_PUBLIC=true
PROXY_PUBLIC_HOST=agentpay.pdf-libre.de

# Tableau de bord privé : seuls l'administrateur et les personnes qu'il autorise (codes d'accès créés
# sur admin.html) le voient. true = consultable par tout le monde (à éviter pour un vrai client).
DASHBOARD_PUBLIC_READ=false

# Serveur MCP en HTTP : accepter les requêtes arrivant par le nom de domaine public
MCP_ALLOWED_HOSTS=agentpay.pdf-libre.de

# Une demande de validation reste ouverte 72 h (3 jours) avant d'expirer
# APPROVAL_TTL_HOURS=72

# Place de marché de démo (npm run market), servie par Caddy sur shop.pdf-libre.de
MARKET_PUBLIC_URL=https://shop.pdf-libre.de

# Telegram : utiliser un AUTRE bot que sur ton Mac (un bot ne peut être lu que par un seul programme à la fois)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
