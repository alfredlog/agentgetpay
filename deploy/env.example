# ADD to the VPS .env (created by `npm run wallet`). Never copy it from your laptop.

# The proxy is public behind Caddy: admin password required, demo keys refused
PROXY_PUBLIC=true
PROXY_PUBLIC_HOST=agentpay.pdf-libre.de

# Private dashboard: only the administrator and the people they authorise (access codes created
# on admin.html) can see it. true = readable by anyone (avoid this for a real customer).
DASHBOARD_PUBLIC_READ=false

# MCP server over HTTP: accept requests arriving through the public host name
MCP_ALLOWED_HOSTS=agentpay.pdf-libre.de

# An approval request stays open for 72 h (3 days) before it expires
# APPROVAL_TTL_HOURS=72

# Card rail: simulated issuer (default). CARD_NETWORK_KEY is created in .env on first start of the proxy;
# restart the demo market afterwards so it can submit card charges.
# CARD_ISSUER=simulated

# Demo market (npm run market), served by Caddy on shop.pdf-libre.de
MARKET_PUBLIC_URL=https://shop.pdf-libre.de

# Telegram: use a DIFFERENT bot than on your laptop (a bot can only be read by one program at a time)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# BSV network: test (default) or main. Drives addresses, the Arcade URL, server wallets and explorer links.
# Switching to main needs a mainnet wallet (new BSV_WIF): coins on testnet do not move to mainnet.
# BSV_NETWORK=test
# Broadcasting and block headers: Arcade. Default = the public instance of BSV_NETWORK
# (main: https://arcade-v2-us-1.bsvblockchain.tech, test: https://arcade-v2-testnet-us-1.bsvblockchain.tech)
# ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech

# Payer wallet (wallet-toolbox) that pays BRC-121 purchases and receives refunds: PAYER_ROOT_KEY is created
# in .env on the first start of the proxy (64 hex characters, never printed). It must be funded separately.
# Merchant wallets (demo market, demo seller) are derived from MARKET_SECRET / SELLER_SECRET.
