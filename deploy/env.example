# ADD to the VPS .env (created by `npm run wallet`). Never copy it from your laptop.

# The proxy is public behind Caddy: admin password required, demo keys refused
PROXY_PUBLIC=true
PROXY_PUBLIC_HOST=agentpay.pdf-libre.de

# Private dashboard: only the administrator and the people they authorise (access codes created
# on admin.html) can see it. true = readable by anyone (avoid this for a real customer).
DASHBOARD_PUBLIC_READ=false

# MCP server over HTTP: accept requests arriving through the public host name
MCP_ALLOWED_HOSTS=agentpay.pdf-libre.de

# An approval request stays open for 72 h (3 days) before it expires
# APPROVAL_TTL_HOURS=72

# Demo market (npm run market), served by Caddy on shop.pdf-libre.de
MARKET_PUBLIC_URL=https://shop.pdf-libre.de

# Telegram: use a DIFFERENT bot than on your laptop (a bot can only be read by one program at a time)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
