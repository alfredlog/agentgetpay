# À ajouter dans le Caddyfile du VPS (souvent /etc/caddy/Caddyfile), puis : sudo systemctl reload caddy
# Caddy obtient et renouvelle le certificat HTTPS tout seul.
agentpay.pdf-libre.de {
	encode gzip

	# Serveur MCP (assistants IA en mode HTTP)
	handle /mcp {
		reverse_proxy 127.0.0.1:5070
	}

	# Liens de dépôt et de téléchargement de fichiers pour les assistants connectés
	handle /files/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy 127.0.0.1:5070
	}

	# Proxy de paiement, tableau de bord et administration
	handle {
		reverse_proxy 127.0.0.1:5050
	}
}

# Place de marché de démo (boutiques fictives) : un AUTRE nom de domaine que le proxy,
# car un agent n'a jamais le droit d'appeler l'adresse du proxy lui-même.
shop.pdf-libre.de {
	encode gzip
	reverse_proxy 127.0.0.1:5080
}
